# Dirección pública de la plataforma (sin / al final)
PLATFORM_URL="https://tu-dominio.vercel.app"
# El mismo WHATSAPP_BRIDGE_TOKEN configurado en Vercel
WHATSAPP_BRIDGE_TOKEN=""

# Límites para cuidar el número (no cambiar sin necesidad)
MAX_PER_HOUR=40
MAX_PER_DAY=200
# Pausa aleatoria entre mensajes, en segundos
MIN_DELAY=6
MAX_DELAY=15
# Horario de envío (hora local del PC); fuera de él los mensajes esperan
SEND_FROM_HOUR=6
SEND_TO_HOUR=21
