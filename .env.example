# ─────────────────────────────────────────────────────────────
#  Mesa de Ayuda — variables de entorno
#  Copie este archivo a .env.local y complete los valores.
# ─────────────────────────────────────────────────────────────

# Nombre de la organización (aparece en la plataforma y en los correos)
NEXT_PUBLIC_ORG_NAME="Constructora ACF"

# URL pública de la plataforma (se usa en los enlaces de los correos)
APP_URL="http://localhost:3000"

# Secreto para firmar las sesiones (mínimo 32 caracteres). Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Base de datos PostgreSQL (Supabase, Neon, RDS, servidor propio...).
# Si se deja vacío se usa una base de datos local embebida en ./.data (solo desarrollo).
DATABASE_URL=""
# Carpeta de la base local embebida (solo si DATABASE_URL está vacío)
# PGLITE_DIR="./.data/helpdesk"

# Administrador inicial (se crea automáticamente la primera vez)
ADMIN_NAME="José Romano"
ADMIN_EMAIL="jromano@acfcia.com"
ADMIN_PASSWORD="CambieEstaClave2026!"

# Contraseña inicial de los demás responsables (Elías Saad, Mario Hernández, Claribel Marchena).
# Si se deja vacía se genera una aleatoria y se muestra en el log del primer arranque.
TEAM_INITIAL_PASSWORD=""

# Dominios de correo autorizados para auto-registro (separados por coma).
# Vacío = solo el administrador puede crear usuarios.
ALLOWED_EMAIL_DOMAINS=""

# ── Correo saliente (SMTP Microsoft 365, igual que el cotizador) ──
# Casilla real con "Authenticated SMTP" habilitado (p. ej. notificacion@acfcia.com).
# Si SMTP_USER / SMTP_PASSWORD están vacíos, los correos quedan en
# "Registro de correos" como simulados y la plataforma funciona igual.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Mesa de Ayuda ACF"
# Buzón al que llegan las respuestas de los usuarios (opcional, ver README)
MAIL_REPLY_TO=""

# ── Respuestas por correo (webhook de entrada) ───────────────
# Secreto que debe enviar el proveedor de correo entrante en ?secret=...
INBOUND_EMAIL_SECRET=""

# Cargar datos de demostración (usuarios responsables y solicitudes de ejemplo)
SEED_DEMO="false"

# ── Resumen diario de alertas (Vercel Cron, 7:00 a. m. hora Colombia, lunes a viernes) ──
CRON_SECRET=""

# ── Notificaciones push (celular / navegador) ──
# Genere las claves con: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:mesadeayuda@acfcia.com"
